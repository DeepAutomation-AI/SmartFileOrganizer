# Copia este archivo a .env. No añadas .env al control de versiones.
# SFO_CONFIG puede seleccionar un YAML/JSON; --config tiene prioridad.
SFO_CONFIG=config/default.yaml

# Email: activa el canal email en notifications.channels para utilizarlo.
# Transporte SMTP con STARTTLS; usa el puerto del servicio correspondiente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Telegram: activa el canal telegram. Nunca guardes el token en config YAML/JSON.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HOME se toma del sistema; no es necesario configurarlo aquí.
